{
  "name": "lint-playground",
  "description": "Sample React app for exploring strict linting setups; composed exclusively from the Miloberry component library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.552.0",
    "miloberry": "workspace:*",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vite-tsconfig-paths": "^6"
  }
}
